# API server
PORT=3001
NODE_ENV=development
# Use a directory dedicated to yoink; startup clears its contents.
YOINK_TEMP_DIR=/var/tmp/yoink
BOT_SECRET=

# Optional Discord bot (same BOT_SECRET as the API)
DISCORD_TOKEN=
DISCORD_APP_ID=
YOINK_API_URL=http://localhost:3001
YOINK_PUBLIC_URL=http://localhost:3001

# Optional extractor and Instagram cobalt instances (not used for YouTube)
EXTRACTOR_URL=http://localhost:3099
COBALT_APIS=
COBALT_API_KEY=

# Optional transcription API; local models use python3 + openai-whisper
WHISPER_SCRIPT=scripts/transcribe.py
OPENAI_API_KEY=

# Optional YouTube authentication
COOKIES_FILE=cookies.txt
YOUTUBE_COOKIES_FILE=youtube-cookies.txt
COOKIE_REFRESH_SCRIPT=
SESSION_GENERATOR_URL=
SESSION_TOKEN_REFRESH_MIN=15
YOUTUBE_POT_PROVIDER_URL=
YOUTUBE_PLAYER_CLIENT=

# Optional proxy
PROXY_HOST=
PROXY_PORT=
PROXY_SCHEME=
PROXY_USER_PREFIX=
PROXY_PASSWORD=
PROXY_COUNT=0

# Optional operational alerts (job details and errors may be sent to Discord)
DISCORD_WEBHOOK_URL=
DISCORD_PING_USER_ID=
